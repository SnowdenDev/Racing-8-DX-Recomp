+/// kart-recomp trace: a call counter (the first 3000 calls are logged) and a hex dump of the first bytes of a buffer.
+bool TraceOn() {
+    static std::atomic<int> calls{0};
+    return calls.fetch_add(1) < 3000;
+}
+
+std::string TraceHex(std::span<const u8> d, size_t n = 16) {
+    std::string out;
+    char b[4];
+    for (size_t i = 0; i < d.size() && i < n; ++i) {
+        std::snprintf(b, sizeof b, "%02x", d[i]);
+        out += b;
+    }
+    return out;
+}
+
