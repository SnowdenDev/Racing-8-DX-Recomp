+// kart-recomp trace: the network info the game polls, logged when it changes (nodes: connected flag, address, name).
+void TraceNetworkInfo(u32 result, const NetworkInfo& info) {
+    static std::string last;
+    char b[160];
+    std::snprintf(b, sizeof b, "result %#x nodes %u/%u", result, static_cast<unsigned>(info.ldn.node_count),
+                  static_cast<unsigned>(info.ldn.node_count_max));
+    std::string now = b;
+    for (size_t i = 0; i < info.ldn.nodes.size(); ++i) {
+        const auto& n = info.ldn.nodes[i];
+        if (!n.is_connected) continue;
+        std::snprintf(b, sizeof b, " [%zu id %d ip %u.%u.%u.%u v%d %.10s]", i, static_cast<int>(n.node_id),
+                      static_cast<unsigned>(n.ipv4_address[0]), static_cast<unsigned>(n.ipv4_address[1]),
+                      static_cast<unsigned>(n.ipv4_address[2]), static_cast<unsigned>(n.ipv4_address[3]),
+                      static_cast<int>(n.local_communication_version), reinterpret_cast<const char*>(n.user_name.data()));
+        now += b;
+    }
+    if (now == last) return;
+    last = now;
+    LOG_INFO(Service_LDN, "trace: GetNetworkInfo {}", now);
+}
+} // namespace
